# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Pipeline artifacts
output/
*.log

# Persistent state (grows over time, machine-specific). Back up separately —
# data/codes.json is irrecoverable from source.
data/

# Large Apify dataset exports
dataset_*.json

# Per-market input folders (Apify exports live here, big binary blobs).
# Track only the curated influencers.txt — generated rankings and
# new_data/ stay ignored.
inputs/*
!inputs/*/
inputs/*/*
!inputs/*/influencers.txt
!inputs/*/handles_pool.txt

# Netherlands side-channel — per-day handoff data is ephemeral and may
# contain raw exports from another project. Track only the procedure doc.
temp_nl/*
!temp_nl/README.md

# macOS
.DS_Store
