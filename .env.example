ANTHROPIC_API_KEY=sk-ant-...

# Apify auth — used for both triggering actor runs and fetching datasets.
APIFY_TOKEN=

# Optional: skip the actor run and reuse an existing dataset id per market.
# Env var name is APIFY_DATASET_ID_<MARKET> in upper case.
APIFY_DATASET_ID_GERMANY=
APIFY_DATASET_ID_BELGIUM=

# Cloudflare R2 — per-run social artifacts (carousel PNGs + new_codes.txt)
# are uploaded under <market>/<YYYY-MM-DD>/ in the bucket configured by
# config.CAROUSEL_BUCKET. Upload is best-effort: if any of these are
# unset the pipeline logs a skip line and continues; the files remain in
# output/<market>/social/.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
